{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zyk-aws-admin-web",
	// 自定义入口：/api/auth/*、/trpc/* 签名后转发给 AWS 后端，其他交给 OpenNext 生成的 .open-next/worker.js
	"main": "worker.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// 统一入口：页面和后端转发都走这一个域名，DNS 记录和证书由 Cloudflare 自动创建
	"routes": [{ "pattern": "admin.izyk.online", "custom_domain": true }],
	// 后端接口地址（基础设施应用栈的输出 ApiEndpoint）。没有 SigV4 签名调不通，所以不算敏感信息。
	// 签名用的 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 是 Worker secrets（wrangler secret put），不写在这里
	"vars": {
		"BACKEND_URL": "https://dopa3ezv96.execute-api.us-east-2.amazonaws.com"
	},
	// 关掉 *.workers.dev 和预览地址，只保留上面一个入口，避免登录 Cookie 对不上
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// next/image 的头像优化走 Cloudflare Images
	// 见 https://opennext.js.org/cloudflare/howtos/image
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
